# Candidate configuration for an ISOLATED backend. Do not source into serving.
# Keep the OpenAI key and GPT-Live configuration unchanged.
JARVIS_META_API_KEY_FILE=/absolute/private/path/meta-provider-api-key

# Qualified compact action-selection format; integrated rollout remains explicit.
# Uses structured JSON, minimal reasoning and the existing bounded executor.
JARVIS_ROUTER_PROVIDER=meta
JARVIS_META_ROUTER_MODEL=muse-spark-1.3

# Keep Gemini: Spark missed both integrated fresh-view deadlines.
JARVIS_PERCEPTION_PROVIDER=gemini

# Existing prerequisites for the unified runtime, not new model features.
JARVIS_COMPANION_STATE_ENABLED=true
