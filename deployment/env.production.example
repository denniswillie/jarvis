# Copy values into jarvis/backend/.env on EC2.
# Do not commit real secrets.

APP_ENV=production
APP_NAME=Jarvis
PUBLIC_BASE_URL=https://your-jarvis.example.invalid
CORS_ALLOW_ORIGINS=[]
LOG_LEVEL=INFO
LOG_JSON=true
JARVIS_STATIC_BEARER_TOKEN=replace_me

SUPABASE_URL=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=replace_me
SUPABASE_DB_POOL_MIN_SIZE=1
SUPABASE_DB_POOL_MAX_SIZE=5
SUPABASE_DB_COMMAND_TIMEOUT_SECONDS=30
SUPABASE_DB_CONNECT_TIMEOUT_SECONDS=10
SUPABASE_STORAGE_BUCKET=jarvis-visual-frames
JARVIS_FILES_STORAGE_BUCKET=jarvis-files

AUDIO_PROVIDER_DEFAULT=openai
GEMINI_LIVE_ENABLED=false
# Use the same admission model in both API and worker; Compose interpolates JARVIS_FRONTIER_MODEL.
JARVIS_FRONTIER_MODEL=gpt-5.6-sol
SECOND_BRAIN_FRONTIER_MODEL=gpt-5.6-sol
SECOND_BRAIN_FRONTIER_REASONING_EFFORT=medium

OPENAI_API_KEY=replace_me
OPENAI_REALTIME_MODEL=replace_me
OPENAI_REALTIME_VOICE=marin
OPENAI_REMINDER_MODEL=replace_me
OPENAI_WEB_SEARCH_MODEL=replace_me

GEMINI_API_KEY=replace_me
GEMINI_VISUAL_MODEL=replace_me
GEMINI_MEMORY_EMBEDDING_MODEL=gemini-embedding-2
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_EMBEDDING_TIMEOUT_SECONDS=20

GOOGLE_OAUTH_CLIENT_ID=replace_me
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=https://your-jarvis.example.invalid/oauth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace_me

JARVIS_IOS_BUNDLE_ID=com.symbiote.jarvis
JARVIS_DAT_CALLBACK_SCHEME=jarvis-dat
PHONE_CAMERA_DEBUG_ENABLED=false
