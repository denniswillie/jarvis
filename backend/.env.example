# Core
APP_ENV=development
APP_NAME=Jarvis
PUBLIC_BASE_URL=https://your-jarvis.example.invalid
CORS_ALLOW_ORIGINS=[]
LOG_LEVEL=INFO
JARVIS_OWNER_ID=replace_with_your_generated_owner_id
JARVIS_STATIC_BEARER_TOKEN=replace_me
JARVIS_MAX_TOOL_CALLS_PER_RESPONSE=12
JARVIS_MAX_REPEATED_TOOL_CALLS_PER_RESPONSE=3
JARVIS_REALTIME_MAX_INTERRUPT_CHAIN=2

# Supabase/Postgres
SUPABASE_URL=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=replace_me
SUPABASE_PASSWORD=replace_me
SUPABASE_STORAGE_BUCKET=jarvis-visual-frames
JARVIS_FILES_STORAGE_BUCKET=jarvis-files

# OpenAI Realtime
OPENAI_API_KEY=replace_me
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
# Continuous shared-view contracts; automatic delivery is wired in Stage 2B.
# Disabling this is an explicit visual fallback, not an audio-session shutdown.
VISUAL_REALTIME_ENABLED=true
VISUAL_REALTIME_MIN_INTERVAL_SECONDS=1.0
VISUAL_REALTIME_MAX_CONTEXT_AGE_SECONDS=5.0
# One shared image-preparation budget, not a separate timeout per operation.
VISUAL_REALTIME_SYNC_TIMEOUT_SECONDS=0.5
# At least four slots: two response inputs plus two for advancing live images.
# Pending/unknown creates and deletes still occupy slots until resolved.
VISUAL_REALTIME_MAX_IMAGE_ITEMS=4
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REMINDER_MODEL=gpt-5.6
OPENAI_CONSOLIDATION_MODEL=gpt-5.6
OPENAI_CONSOLIDATION_TIMEOUT_SECONDS=60
JARVIS_AUDIO_SAMPLE_RATE=24000
JARVIS_AUDIO_FORMAT=pcm16
JARVIS_REALTIME_MAX_SESSION_SECONDS=3300
JARVIS_REALTIME_MAX_CLIENT_MESSAGE_BYTES=1000000
JARVIS_REALTIME_MAX_AUDIO_CHUNK_BYTES=262144
JARVIS_REALTIME_RECENT_MESSAGES_LIMIT=12
VISUAL_RAW_FRAME_TTL_SECONDS=300
VISUAL_FRAME_MAX_BYTES=512000
VISUAL_FRAME_MAX_WIDTH=1024
VISUAL_FRAME_MAX_HEIGHT=1024
VISUAL_LATEST_FRAME_TTL_SECONDS=10
VISUAL_LATEST_CAPTURE_MAX_AGE_SECONDS=10
VISUAL_SENSORY_WINDOW_MAX_FRAMES=4
VISUAL_SENSORY_WINDOW_TTL_SECONDS=10

# Gemini visual analyzer
GEMINI_API_KEY=replace_me
GEMINI_VISUAL_MODEL=gemini-3.1-flash-lite
VISUAL_ANALYZER_MAX_CONCURRENCY=6
VISUAL_ANALYZER_MAX_PENDING_FRAMES=8
VISUAL_FAST_PERCEPTION_ENABLED=true
VISUAL_FAST_PERCEPTION_MAX_WINDOW_FRAMES=4
VISUAL_FAST_PERCEPTION_TIMEOUT_SECONDS=20
WORKING_MEMORY_TTL_SECONDS=120
WORKING_MEMORY_ENTITY_TTL_SECONDS=30
WORKING_MEMORY_VISIBLE_TEXT_TTL_SECONDS=60
WORKING_MEMORY_MAX_ENTITIES=30
WORKING_MEMORY_MAX_RECENT_CHANGES=12
PERCEPTION_EVENT_IDLE_CLOSE_SECONDS=12
PERCEPTION_EVENT_MAX_SECONDS=120
PERCEPTION_EVENT_SWEEP_INTERVAL_SECONDS=5
EVENT_KEYFRAME_MAX_COUNT=3
EVENT_CONSOLIDATION_KEYFRAME_MAX_COUNT=6
EVENT_KEYFRAME_CANDIDATE_MAX_COUNT=12
EVENT_CANDIDATE_RETENTION_SECONDS=1800
EVENT_ORDINARY_KEYFRAME_RETENTION_SECONDS=86400
VISUAL_INTERRUPT_CONFIDENCE_THRESHOLD=0.85
VISUAL_INTERRUPT_DEDUPE_SECONDS=10

# Durable memory embeddings
GEMINI_MEMORY_EMBEDDING_MODEL=gemini-embedding-2
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_EMBEDDING_TIMEOUT_SECONDS=20

# Durable memory jobs
MEMORY_JOB_RUNNER_ENABLED=false
MEMORY_JOB_POLL_INTERVAL_SECONDS=2
MEMORY_JOB_MAX_CONCURRENCY=2
MEMORY_JOB_CLAIM_TIMEOUT_SECONDS=120
MEMORY_JOB_DEFAULT_MAX_ATTEMPTS=3
MEMORY_JOB_RECONCILE_INTERVAL_SECONDS=60
MEMORY_MAINTENANCE_ENABLED=false
MEMORY_MAINTENANCE_INTERVAL_SECONDS=300
MEMORY_VISUAL_FRAME_EXPIRY_INTERVAL_SECONDS=60
MEMORY_MAINTENANCE_BATCH_SIZE=500
MEMORY_OBSERVATION_DETAIL_RETENTION_DAYS=7
MEMORY_UNREFERENCED_OBSERVATION_RETENTION_DAYS=30
MEMORY_UNREFERENCED_VISUAL_FRAME_RETENTION_DAYS=30
MEMORY_COMPLETED_JOB_RETENTION_DAYS=14
MEMORY_RETRIEVAL_AUDIT_RETENTION_DAYS=30
MEMORY_CONSOLIDATION_MAX_KEYFRAMES=6
MEMORY_CONSOLIDATION_MAX_TRANSCRIPTS=20
MEMORY_EPISODE_PROMOTION_MIN_IMPORTANCE=0.55
MEMORY_IMPORTANT_KEYFRAME_MIN_IMPORTANCE=0.80
MEMORY_SKIPPED_EVENT_RETENTION_DAYS=90
MEMORY_SEMANTIC_INFERENCE_MIN_CONFIDENCE=0.85
MEMORY_SEMANTIC_SUPERSEDE_MIN_CONFIDENCE=0.90
MEMORY_REFLECTION_MIN_NEW_EPISODES=8
MEMORY_REFLECTION_MAX_EPISODES=30
MEMORY_INFERRED_PREFERENCE_MIN_SUPPORTING_EPISODES=3
MEMORY_INFERRED_PREFERENCE_MIN_CONFIDENCE=0.85
MEMORY_PROCEDURE_MIN_SUPPORTING_EPISODES=3
MEMORY_PROFILE_MAX_CHARACTERS=16000
MEMORY_PROFILE_SECTION_ITEM_LIMIT=20
MEMORY_PROFILE_RECENT_EPISODE_LIMIT=12
MEMORY_PROFILE_SUPERSEDED_HISTORY_LIMIT=10
MEMORY_PROFILE_RECOVERY_BATCH_SIZE=100

# Backend-owned reminder delivery
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_INTERVAL_SECONDS=10
REMINDER_TRIGGER_CLAIM_TIMEOUT_SECONDS=120
REMINDER_TRIGGER_MAX_ATTEMPTS=3

# Google Calendar
GOOGLE_OAUTH_CLIENT_ID=replace_me
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=https://your-jarvis.example.invalid/oauth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace_me
GOOGLE_CALENDAR_SCOPES=["https://www.googleapis.com/auth/calendar"]
JARVIS_TIMEZONE=Europe/Dublin

# Web fetch and OpenAI web search
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_CACHE_TTL_SECONDS=900
OPENAI_WEB_SEARCH_MODEL=gpt-5.6
WEB_SEARCH_TIMEOUT_SECONDS=20

# iOS / Meta DAT
JARVIS_IOS_BUNDLE_ID=com.symbiote.jarvis
JARVIS_DAT_CALLBACK_SCHEME=jarvis-dat

# Feature flags
PHONE_CAMERA_DEBUG_ENABLED=false
